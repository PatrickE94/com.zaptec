{
  "name": "com.zaptec",
  "version": "1.0.0",
  "description": "Integrate Zaptec products into your Homey",
  "main": "app.ts",
  "author": "Patrick Wadström",
  "bugs": {
    "url": "https://github.com/PatrickE94/com.zaptec/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PatrickE94/com.zaptec.git"
  },
  "keywords": [
    "zaptec",
    "homey"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "lint": "oxlint",
    "test": "mocha",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "validate": "npx --yes homey@4 app validate --level verified",
    "review": "npx --yes homey@4 app review --type update",
    "build": "tsc",
    "build:widget": "rollup -p @rollup/plugin-node-resolve widgets/control-charger/public/index.js -o widgets/control-charger/public/bundle.js",
    "start": "npx --yes homey@4 app run",
    "prepare": "git config core.hooksPath .githooks || true",
    "publish": "npx --yes homey@4 app publish"
  },
  "devDependencies": {
    "@material/web": "^2.5.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@tsconfig/node22": "^22.0.6",
    "@types/homey": "npm:homey-apps-sdk-v3-types@^0.3.12",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.4",
    "@types/node-cron": "^3.0.11",
    "@types/source-map-support": "^0.5.6",
    "assert": "^2.1.0",
    "mocha": "^12.0.2",
    "nock": "^14.0.17",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "rollup": "^4.63.4",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "node-cron": "^3.0.3",
    "source-map-support": "^0.5.21"
  },
  "overrides": {
    "node-cron": {
      "uuid": "^11.1.1"
    }
  }
}
