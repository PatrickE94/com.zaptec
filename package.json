{
  "name": "com.zaptec",
  "version": "1.0.0",
  "description": "Integrate Zaptec products into your Homey",
  "main": "app.ts",
  "author": "Patrick Wadström",
  "bugs": {
    "url": "https://github.com/patricke94/dev.wdstrm.zaptec/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/patricke94/dev.wdstrm.zaptec.git"
  },
  "keywords": [
    "zaptec",
    "homey"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "lint": "eslint --ext .js,.ts --ignore-path .gitignore .",
    "test": "mocha",
    "prettier": "prettier --write \"**/*.ts\"",
    "validate": "homey app validate --level verified",
    "build": "tsc",
    "build:widget": "rollup -p @rollup/plugin-node-resolve widgets/control-charger/public/index.js -o widgets/control-charger/public/bundle.js",
    "start": "homey app run",
    "publish": "homey app publish"
  },
  "devDependencies": {
    "@material/web": "^2.5.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@tsconfig/node16": "^16.1.9",
    "@types/homey": "npm:homey-apps-sdk-v3-types@^0.3.12",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.4",
    "@types/node-cron": "^3.0.11",
    "@types/source-map-support": "^0.5.6",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "assert": "^2.1.0",
    "eslint": "~8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-airbnb-typescript": "^18.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "mocha": "^12.0.2",
    "nock": "^14.0.17",
    "prettier": "^3.9.9",
    "rollup": "^4.63.4",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "node-cron": "^3.0.3",
    "source-map-support": "^0.5.21"
  },
  "overrides": {
    "node-cron": {
      "uuid": "^11.1.1"
    }
  }
}
