{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "singleQuote": true,
  "trailingComma": "all",
  "experimentalOperatorPosition": "start",
  "sortPackageJson": false,
  "ignorePatterns": ["**/*.json", "**/*.md", "**/*.yml", "**/*.html", "**/*.css", "widgets/*/public/bundle.js"]
}
